{
  "name": "@waynesutton/builder-skills",
  "version": "3.0.0",
  "description": "Workflow, security, and writing skills for builders shipping Convex apps: PRDs, task.md, docs synced from git, git safety, sec-check, and a writing guide. Run npx builder-skills. Works with Claude Code, Codex, Cursor, OpenCode, and any agent that reads SKILL.md.",
  "author": "Wayne Sutton <https://waynesutton.ai> (@waynesutton)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waynesutton/builder-skills.git"
  },
  "homepage": "https://github.com/waynesutton/builder-skills#readme",
  "bugs": {
    "url": "https://github.com/waynesutton/builder-skills/issues"
  },
  "keywords": [
    "builder-skills",
    "agent-skills",
    "skills",
    "convex",
    "claude-code",
    "codex",
    "cursor",
    "opencode",
    "prd",
    "changelog",
    "workflow",
    "security",
    "writing",
    "skills-sh"
  ],
  "type": "module",
  "main": "index.js",
  "bin": {
    "builder-skills": "./bin/cli.js"
  },
  "files": [
    ".claude-plugin/",
    "skills/manifest.json",
    "skills/**/*.md",
    "skills/**/agents/openai.yaml",
    "skills/**/assets/*",
    "skills/**/scripts/*",
    "templates/**/*",
    "AGENTS.md",
    "GEMINI.md",
    "index.js",
    "bin/"
  ],
  "scripts": {
    "check": "node scripts/check-skills.mjs",
    "prepublishOnly": "node scripts/check-skills.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
